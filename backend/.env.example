# RecoverPay AI Backend Configuration Template
# Copy this file to .env and fill in your actual values.
# IMPORTANT: .env is in .gitignore and will never be committed to GitHub.

# ============================================================================
# Server Configuration
# ============================================================================
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ============================================================================
# PostgreSQL Database
# ============================================================================
# Local development: update with your PostgreSQL credentials
# Production: use a managed database service (AWS RDS, Azure Database, Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=raz_ai
DB_USER=postgres
DB_PASSWORD=

# ============================================================================
# AI Analysis Engine (Groq / LLM Backend)
# ============================================================================
# Get your Groq API key from: https://console.groq.com
# Keep this secret on the backend only. NEVER expose to frontend.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Backward-compatible aliases for local development
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_USE_REMOTE=true
# Optional: JSON override for testing, e.g. {"root_cause":"unsafe","risk_level":"high"}
AI_MOCK_RESPONSE=

# ============================================================================
# Resend Email Integration (Server-side Only)
# ============================================================================
# IMPORTANT: Email sending requires both keys to be configured.
#
# Development Flow:
# 1. Get free API key from: https://resend.com/api-tokens
# 2. Verify your personal email in Resend (used for testing)
# 3. Set RESEND_VERIFIED_TEST_EMAIL to that email
# 4. Set RESEND_FROM_EMAIL to: RecoverPay AI <your-verified-email@gmail.com>
# 5. Set RESEND_MODE=development
# 6. All emails will automatically redirect to RESEND_VERIFIED_TEST_EMAIL
#
# Production Flow (when you verify a domain):
# 1. Verify a custom domain at https://resend.com/domains
# 2. Change RESEND_FROM_EMAIL to: RecoverPay AI <recovery@yourdomain.com>
# 3. Change RESEND_MODE=production
# 4. Now emails can be sent to any recipient
#
# Security Notes:
# - Keep RESEND_API_KEY secret on backend ONLY
# - NEVER commit .env to version control
# - RESEND_VERIFIED_TEST_EMAIL is only used in development mode
#
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=RecoverPay AI <your-verified-email@gmail.com>
RESEND_VERIFIED_TEST_EMAIL=your-verified-email@gmail.com
RESEND_MODE=development
RECOVERY_ALERT_EMAIL=your-verified-email@gmail.com

# ============================================================================
# Razorpay Integration
# ============================================================================
# Use TEST credentials while developing. Never commit real credentials.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================================
# Retry Configuration
# ============================================================================
MAX_RETRY_ATTEMPTS=2
RETRY_DELAY_MINUTES=30

# Optional Stripe integration
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Recovery Mode: simulated (default, safe) or real (requires REAL_ACTIONS_ENABLED=true)
RECOVERY_MODE=simulated
REAL_ACTIONS_ENABLED=false
